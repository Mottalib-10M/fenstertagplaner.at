---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = (name: string, t: string, h: number) => `<iframe src="${SITE_URL}/embed/${lang}/${name}/" title="${t}" width="100%" height="${h}" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const items = [
  { name: 'fenstertage-planer', h2: 'Bridge-day planner', text: 'Province, year and leave days: your readers see the best plan and every bridge day of the year, optionally with the patron saint.', t: 'Austrian bridge-day planner', h: 980 },
  { name: 'feiertage', h2: 'Holidays by province', text: "The 13 statutory holidays for 2026 to 2028 with weekdays, plus the chosen province's patron saint's day.", t: 'Public holidays in Austria', h: 900 },
];
---
<PageLayout title="Embed AT Fenstertage for free: planner and holidays" description="Embed the Austrian bridge-day planner and holiday list for free with an iframe: copy the code once, and new years and rule changes then appear by themselves." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed AT Fenstertage</h1>
    <p class="mt-3 text-lg text-navy-700">For works councils, HR departments, parents' associations and local papers: copy once, and new years appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    {items.map((i) => (<>
      <h2>{i.h2}</h2>
      <p>{i.text}</p>
      <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code(i.name, i.t, i.h)}</code></pre>
    </>))}
    <p>For the German version, replace <code>/embed/en/</code> with <code>/embed/de/</code>. Terms: the source link under the calculator stays visible, the calculator is not altered, and it is provided without warranty. What your readers enter stays on their device. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/fenstertage-planer/`} title="Austrian bridge-day planner" width="100%" height="980" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
